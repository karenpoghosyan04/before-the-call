{
  "name": "smoke",
  "device": "cpu",
  "threads": 2,
  "split_fractions": [0.6, 0.2, 0.2],
  "seed": 42,
  "repeat_seeds": [42],
  "max_rows_per_split": 600,
  "mlp": {
    "hidden": [16, 8], "dropout": 0.1, "weight_decay": 0.0001,
    "learning_rate": 0.001, "batch_size": 128, "max_epochs": 3,
    "patience": 2, "min_delta": 0.0001
  },
  "class_weight_options": ["none", "balanced"],
  "logistic_C": 1.0,
  "tree": {"max_iter": 10, "max_leaf_nodes": 7, "learning_rate": 0.08, "l2_regularization": 1.0}
}
